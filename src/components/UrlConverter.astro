---
// URL 转换器组件 - 纯 Astro + 原生 JS
import LinePicker from './LinePicker.astro';
import SelectMenu from './SelectMenu.astro';
import { menuOption } from '../lib/menu';
---

<div class="url-converter">
  <!-- 输入区域 -->
  <!-- backdrop-filter 让每张玻璃卡片各自成层叠上下文,需 relative z-10 才能压住 DOM 靠后的"加速线路"卡片 -->
  <div class="relative z-10 bg-surface rounded-2xl p-4 mb-4 border border-outline-variant">
    <!-- 手机上输入框独占一行:和 128px 的格式选择器并排只剩 150px,长链接看不出转的是什么 -->
    <div class="flex flex-col gap-2 sm:flex-row">
      <!-- group 让清除按钮能响应整个输入框的悬停,而不是只响应按钮自己 -->
      <!-- min-w-0:默认 min-width:auto 会让 input 按 size 撑住最小宽度,320 屏下顶破卡片 -->
      <div class="relative flex-1 min-w-0 group">
        <input 
          type="text" 
          id="url-input"
          aria-label="待转换的源站链接"
          placeholder="例如: https://raw.githubusercontent.com/cli/cli/trunk/README.md"
          class="w-full px-4 py-2 pr-11 bg-surface-container-low border border-outline-variant rounded-xl text-on-surface focus:outline-none focus:border-primary transition-colors"
        />
        <button 
          type="button"
          id="clear-input-btn"
          aria-label="清除输入"
          title="清除"
          class="absolute right-2.5 top-1/2 -translate-y-1/2 w-7 h-7 flex items-center justify-center text-error opacity-0 group-hover:opacity-100 group-focus-within:opacity-100 focus-visible:opacity-100 transition-opacity"
        >
          <span class="icon-[material-symbols--close-rounded] text-lg"></span>
        </button>
      </div>
      <!-- 格式选择器：外壳与线路选择器共用(SelectMenu.astro)，宽度下限是这个页面自己的 -->
      <SelectMenu
        name="format"
        size="field"
        label="直接链接"
        ariaLabel="选择输出格式"
        triggerClass="min-w-[128px] sm:min-w-[140px]"
        class="self-start sm:self-auto"
      >
        <button class:list={[menuOption, 'format-option flex items-center gap-3']} data-menu-option data-value="direct">
          <span class="icon-[material-symbols--link] text-lg"></span>
          <span>直接链接</span>
        </button>
        <button class:list={[menuOption, 'format-option flex items-center gap-3']} data-menu-option data-value="git">
          <span class="icon-[simple-icons--git] text-lg"></span>
          <span>Git Clone</span>
        </button>
        <button class:list={[menuOption, 'format-option flex items-center gap-3']} data-menu-option data-value="wget">
          <span class="icon-[material-symbols--download] text-lg"></span>
          <span>Wget</span>
        </button>
        <button class:list={[menuOption, 'format-option flex items-center gap-3']} data-menu-option data-value="docker">
          <span class="icon-[simple-icons--docker] text-lg"></span>
          <span>Docker Pull</span>
        </button>
      </SelectMenu>
    </div>
    
    <!-- 快捷示例 -->
    <div class="flex flex-wrap gap-2 mt-3">
      <button class="example-btn text-xs px-3 py-1.5 bg-surface-container-high rounded-full text-on-surface-variant hover:bg-primary/10 hover:text-primary transition-colors" data-example="https://github.com/cli/cli/releases/download/v2.67.0/gh_2.67.0_windows_amd64.zip">
        Release 文件
      </button>
      <button class="example-btn text-xs px-3 py-1.5 bg-surface-container-high rounded-full text-on-surface-variant hover:bg-primary/10 hover:text-primary transition-colors" data-example="https://github.com/octocat/Hello-World.git">
        Git 仓库
      </button>
      <button class="example-btn text-xs px-3 py-1.5 bg-surface-container-high rounded-full text-on-surface-variant hover:bg-primary/10 hover:text-primary transition-colors" data-example="https://github.com/cli/cli/blob/trunk/README.md">
        Raw 文件
      </button>
      <button class="example-btn text-xs px-3 py-1.5 bg-surface-container-high rounded-full text-on-surface-variant hover:bg-primary/10 hover:text-primary transition-colors" data-example="library/nginx:latest">
        Docker 镜像
      </button>
      <button class="example-btn text-xs px-3 py-1.5 bg-surface-container-high rounded-full text-on-surface-variant hover:bg-primary/10 hover:text-primary transition-colors" data-example="https://cdn.jsdelivr.net/npm/vue@3/dist/vue.global.prod.js">
        jsDelivr 资源
      </button>
      <button class="example-btn text-xs px-3 py-1.5 bg-surface-container-high rounded-full text-on-surface-variant hover:bg-primary/10 hover:text-primary transition-colors" data-example="https://repo1.maven.org/maven2/junit/junit/4.13.2/junit-4.13.2.pom">
        Maven 构件
      </button>
      <button class="example-btn text-xs px-3 py-1.5 bg-surface-container-high rounded-full text-on-surface-variant hover:bg-primary/10 hover:text-primary transition-colors" data-example="https://pypi.org/simple/requests/">
        PyPI 索引
      </button>
    </div>
  </div>

  <!-- 输出区域 -->
  <div id="output-section" class="hidden">
    <!-- 不能加 overflow-hidden:线路菜单从这里往下展开会超出卡片高度,被裁掉 -->
    <div class="bg-surface rounded-2xl border border-outline-variant">
      <div class="relative z-20 flex items-center justify-between gap-2 px-4 py-3 bg-surface-container border-b border-outline-variant rounded-t-2xl">
        <span class="text-sm font-medium text-on-surface shrink-0">加速线路</span>
        <div class="flex items-center gap-1 min-w-0">
          <LinePicker size="sm" />
          <button id="copy-btn" aria-label="复制" class="w-9 h-9 rounded-full flex items-center justify-center text-on-surface-variant hover:bg-primary/10 hover:text-primary transition-colors" title="复制">
            <span class="icon-[material-symbols--content-copy] text-lg"></span>
          </button>
          <button id="open-btn" aria-label="在新窗口打开" class="w-9 h-9 rounded-full flex items-center justify-center text-on-surface-variant hover:bg-primary/10 hover:text-primary transition-colors" title="在新窗口打开">
            <span class="icon-[material-symbols--open-in-new] text-lg"></span>
          </button>
        </div>
      </div>
      <div class="p-4">
        <div class="bg-primary-container rounded-xl p-3">
          <div id="converted-url" class="text-sm text-on-primary-container break-all font-mono font-medium"></div>
        </div>
      </div>
    </div>
  </div>

  <!-- 提示信息 -->
  <div id="error-message" class="hidden mt-4 bg-error-container text-on-error-container rounded-xl p-3 text-sm">
  </div>
</div>

<script>
  import { PREFIX_BY_HOST, githubFileProxyPath } from '../lib/services';
  // 选择器的开合（互斥、点外面或 Esc 收起）在共享层里，页面不管菜单怎么开关
  import '../lib/menu';
  import { initLines, lineBase, onLineChange } from '../lib/lines';

  const urlInput = document.getElementById('url-input');
  const formatSelectText = document.querySelector('[data-menu="format"] [data-menu-text]');
  const formatOptions = document.querySelectorAll('.format-option');
  let currentFormat = 'direct';
  const outputSection = document.getElementById('output-section');
  const originalUrl = document.getElementById('original-url');
  const convertedUrl = document.getElementById('converted-url');
  const errorMessage = document.getElementById('error-message');
  const copyBtn = document.getElementById('copy-btn');
  const openBtn = document.getElementById('open-btn');
  const clearInputBtn = document.getElementById('clear-input-btn');

  // 结果链接的前缀由共享线路层给出（选哪条、跨页同步、按延迟兜底都在 src/lib/lines.ts）
  function proxyBase() {
    return lineBase();
  }

  // URL 转换逻辑
  function convertUrl(input, format) {
    if (!input.trim()) return null;

    // Docker 镜像格式
    if (format === 'docker' || (!input.includes('http') && input.includes('/'))) {
      if (!input.includes(' ') && !input.includes('http')) {
        return {
          original: input,
          converted: `docker pull ${proxyBase()}/${input}`,
          url: `${proxyBase()}/${input}`
        };
      }
    }

    try {
      // 确保有协议
      let urlStr = input.trim();
      if (!/^https?:\/\//i.test(urlStr)) {
        urlStr = 'https://' + urlStr;
      }

      const url = new URL(urlStr);
      const host = url.hostname;
      const path = url.pathname;

      // 域名 -> 前缀与上游注册表同源(src/lib/services)：新增加速服务只改注册表，转换器自动跟上
      const prefix = PREFIX_BY_HOST[host] ?? PREFIX_BY_HOST[host.replace(/^www\./, '')];
      if (!prefix) {
        return { error: `不支持的域名: ${host}` };
      }
      // github.com 地址栏里的文件链接是网页形状(/blob/<ref>/<path>)，直接搬进 /api/gh/ 会
      // 给用户一个 GitHub 页面；按 raw 端点形状给出即纯文件，也省掉 /raw/ 形态那次 302
      const githubFile = host.replace(/^www\./, '') === 'github.com' ? githubFileProxyPath(path) : null;
      // 保留查询串：avatars 的 ?v=4、PyPI 索引的 ?format= 都参与语义
      const proxyPath = (githubFile ?? prefix + path) + url.search;

      const fullUrl = proxyBase() + proxyPath;

      // 根据格式返回
      switch (format) {
        case 'git':
          if (path.endsWith('.git')) {
            return {
              original: input,
              converted: `git clone ${fullUrl}`,
              url: fullUrl
            };
          }
          return { error: 'Git Clone 需要以 .git 结尾的仓库链接' };
        case 'wget':
          return {
            original: input,
            converted: `wget "${fullUrl}"`,
            url: fullUrl
          };
        default:
          return {
            original: input,
            converted: fullUrl,
            url: fullUrl
          };
      }
    } catch (e) {
      return { error: '无效的 URL 格式' };
    }
  }

  // 更新输出
  function updateOutput() {
    const input = urlInput.value;
    const format = currentFormat;
    
    errorMessage.classList.add('hidden');
    outputSection.classList.add('hidden');

    if (!input.trim()) return;

    const result = convertUrl(input, format);

    if (result.error) {
      errorMessage.textContent = result.error;
      errorMessage.classList.remove('hidden');
      return;
    }

    convertedUrl.textContent = result.converted;
    outputSection.classList.remove('hidden');

    // 保存到 localStorage
    localStorage.setItem('lastUrl', input);
    localStorage.setItem('lastFormat', format);
  }

  // 事件监听
  urlInput.addEventListener('input', updateOutput);

  // 菜单当前项的标记:初始化也要打,否则默认项看不出选中
  function markActiveFormat() {
    formatOptions.forEach(opt => opt.classList.toggle('menu-active', opt.dataset.value === currentFormat));
  }

  // 选项点击:收起浮层由共享层负责,这里只管选中
  formatOptions.forEach(option => {
    option.addEventListener('click', () => {
      currentFormat = option.dataset.value;
      formatSelectText.textContent = option.querySelector('span:last-child').textContent;
      
      // 更新选中状态
      markActiveFormat();
      
      updateOutput();
    });
  });

  // 示例按钮
  document.querySelectorAll('.example-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      urlInput.value = btn.dataset.example;
      updateOutput();
    });
  });

  // 清除输入
  clearInputBtn?.addEventListener('click', () => {
    urlInput.value = '';
    // 清掉回填值,否则刷新后又会带出上次链接
    localStorage.removeItem('lastUrl');
    urlInput.focus();
    updateOutput();
  });

  // 复制功能
  copyBtn.addEventListener('click', async () => {
    const text = convertedUrl.textContent;
    try {
      await navigator.clipboard.writeText(text);
      copyBtn.innerHTML = '<span class="icon-[material-symbols--check] text-lg"></span>';
      setTimeout(() => {
        copyBtn.innerHTML = '<span class="icon-[material-symbols--content-copy] text-lg"></span>';
      }, 2000);
    } catch (err) {
      console.error('复制失败:', err);
    }
  });

  // 打开链接
  openBtn.addEventListener('click', () => {
    const url = convertedUrl.textContent;
    if (url && url.startsWith('http')) {
      window.open(url, '_blank');
    }
  });

  // 恢复上次的输入
  const lastUrl = localStorage.getItem('lastUrl');
  const lastFormat = localStorage.getItem('lastFormat');
  if (lastUrl) {
    urlInput.value = lastUrl;
    if (lastFormat) currentFormat = lastFormat;
    updateOutput();
  }
  // 首屏就把选中态和触发器文字对齐到实际格式
  markActiveFormat();
  const initialOption = Array.from(formatOptions).find(opt => opt.dataset.value === currentFormat);
  if (initialOption) formatSelectText.textContent = initialOption.querySelector('span:last-child').textContent;

  // 换线路要重算结果:链接前缀是拼出来的,不是事后替换
  onLineChange(() => updateOutput());
  initLines();
</script>
