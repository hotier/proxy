---
// 基础布局组件 - 品牌元信息、导航栏与页脚
import BrandMark from '../components/BrandMark.astro';
import { BRAND, THEME_COLOR, uptimeText } from '../lib/brand';
// 走 Vite 打包(生产输出 dist/client/_astro/*.css);直接 <link> 源码路径在生产会 404
import '../styles/global.css';

export interface Props {
  title: string;
  description?: string;
  activeNav?: string;
}

const { title, description = BRAND.description, activeNav = '' } = Astro.props;
const currentPath = Astro.url.pathname;

// 导航项配置（Iconify 类名需完整出现在源码中供 Tailwind 扫描）
const navItems = [
  { path: '/', label: '加速访问', iconClass: 'icon-[material-symbols--speed]' },
  { path: '/github', label: 'GitHub', iconClass: 'icon-[simple-icons--github]' },
  { path: '/docker', label: 'Docker', iconClass: 'icon-[simple-icons--docker]' },
  { path: '/packages', label: 'Packages', iconClass: 'icon-[boxicons--package-filled]' },
  { path: '/status', label: '状态', iconClass: 'icon-[material-symbols--monitoring]' },
];

// 判断当前激活的导航项
const isActive = (path: string) => {
  if (path === '/') return currentPath === '/';
  return currentPath.startsWith(path);
};

// SSR 下按请求域名生成绝对地址，分享爬虫需要绝对 URL
const fullTitle = `${title} · ${BRAND.name}`;
const canonical = new URL(currentPath, Astro.url.origin).href;
const ogImage = new URL('/og-image.jpg', Astro.url.origin).href;
---

<!DOCTYPE html>
<html lang="zh-CN" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content={description}>
  <meta name="author" content={BRAND.name}>
  <title>{fullTitle}</title>
  <link rel="canonical" href={canonical}>
  <meta name="theme-color" content={THEME_COLOR.light}>
  <link rel="manifest" href="/manifest.webmanifest">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="alternate icon" type="image/x-icon" href="/favicon.ico">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">

  <!-- 社交分享卡片 -->
  <meta property="og:type" content="website">
  <meta property="og:site_name" content={BRAND.name}>
  <meta property="og:locale" content="zh_CN">
  <meta property="og:title" content={fullTitle}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={ogImage}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content={BRAND.tagline}>
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={fullTitle}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={ogImage}>
  
  <!-- 主题预应用:渲染前设置 class,避免暗色用户刷新白屏闪烁;地址栏配色同步 -->
  <!-- data-theme 记录用户偏好,主题图标由 CSS 按它挑选,省掉首屏后 JS 改类名造成的图标闪跳 -->
  <script is:inline define:vars={{ themeLight: THEME_COLOR.light, themeDark: THEME_COLOR.dark }}>
    (function () {
      try {
        var t = localStorage.getItem('theme') || 'system';
        var d = t === 'dark' || (t === 'system' && matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.classList.toggle('dark', d);
        document.documentElement.classList.toggle('light', t === 'light');
        document.documentElement.dataset.theme = t;
        var m = document.querySelector('meta[name="theme-color"]');
        if (m) m.setAttribute('content', d ? themeDark : themeLight);
      } catch (e) {}
    })();
  </script>
  
  <!-- 字体:使用本地字体栈(--font-roboto),不引入外部字体,避免加载后文字回流抖动 -->
  
</head>
<body class="text-on-surface font-roboto">
  <div class="min-h-screen flex flex-col">
    <!-- 顶部导航栏 -->
    <header class="lg border-b border-outline-variant sticky top-0 z-50">
      <div class="container mx-auto max-w-6xl px-4">
        <div class="flex items-center h-16 gap-4">
          {/* Logo：品牌标识 + 中文简称 + 拉丁字标 */}
          <a href="/" class="flex items-center gap-2.5 hover:opacity-80 transition-opacity mr-auto" aria-label={`${BRAND.name} 首页`}>
            <BrandMark size={30} class="text-primary" />
            <span class="hidden sm:flex flex-col leading-none">
              <span class="text-lg font-semibold text-on-surface">{BRAND.short}</span>
              <span class="text-[10px] tracking-[0.2em] text-on-surface-variant mt-1">{BRAND.wordmark}</span>
            </span>
          </a>
          
          <!-- 桌面导航 -->
          <nav class="hidden md:flex items-center gap-1">
            {navItems.map(item => (
              <a
                href={item.path}
                class:list={[
                  'flex items-center gap-2 px-4 py-2 rounded-full text-sm font-medium transition-colors lg-press',
                  isActive(item.path)
                    ? 'bg-primary text-on-primary'
                    : 'text-on-surface-variant hover:bg-primary/15 hover:text-primary'
                ]}
              >
                <span class:list={[item.iconClass, 'text-lg']}></span>
                {item.label}
              </a>
            ))}
          </nav>
          
          <!-- 主题切换：点击按 亮色 → 暗色 → 跟随系统 轮播，偏好存 localStorage -->
          <button 
            id="theme-toggle-btn"
            class="w-10 h-10 flex items-center justify-center rounded-full text-on-surface-variant hover:bg-primary/15 hover:text-primary transition-colors lg-press"
            aria-label="切换主题"
            title="切换主题"
          >
            <span id="theme-icon" aria-hidden="true">
              <span class="theme-glyph theme-glyph-light icon-[material-symbols--light-mode]"></span>
              <span class="theme-glyph theme-glyph-dark icon-[material-symbols--dark-mode]"></span>
              <span class="theme-glyph theme-glyph-system icon-[cuida--monitor-outline]"></span>
            </span>
          </button>

          <!-- 移动端菜单按钮 -->
          <button 
            id="mobile-menu-btn"
            class="md:hidden w-10 h-10 flex items-center justify-center rounded-full text-on-surface-variant hover:bg-primary/15 hover:text-primary transition-colors lg-press"
            aria-label="打开菜单"
            aria-expanded="false"
            aria-controls="mobile-menu"
          >
            <span class="icon-[material-symbols--menu] text-2xl"></span>
          </button>
        </div>
      </div>
      
      <!-- 移动端导航菜单 -->
      <div id="mobile-menu" class="lg hidden md:hidden border-t border-outline-variant">
        <nav class="container mx-auto max-w-6xl px-4 py-2">
          {navItems.map(item => (
            <a
              href={item.path}
              class:list={[
                'flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium transition-colors mb-1',
                isActive(item.path)
                  ? 'bg-primary text-on-primary'
                  : 'text-on-surface-variant hover:bg-primary/15 hover:text-primary'
              ]}
            >
              <span class:list={[item.iconClass, 'text-xl']}></span>
              {item.label}
            </a>
          ))}
        </nav>
      </div>
    </header>

    <!-- 主内容区：page-enter 让顶层内容块按序淡入，路由切换更连贯 -->
    <main class="flex-grow">
      <div class="page-enter container mx-auto max-w-6xl px-4 py-6">
        <slot />
      </div>
    </main>

    <!-- 页脚 -->
    <footer class="lg border-t border-outline-variant mt-auto">
      <div class="container mx-auto max-w-6xl px-4 py-2.5">
        <p class="text-center text-on-surface-variant text-sm">
          {BRAND.name} · 基于 <a href="https://deno.com/deploy" target="_blank" class="text-primary hover:underline">Deno Deploy</a> 边缘网络 · {uptimeText()}
        </p>
      </div>
    </footer>
  </div>

  <!-- 移动端菜单切换脚本 -->
  <script>
    const mobileMenuBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    
    function setMobileMenu(open) {
      mobileMenu?.classList.toggle('hidden', !open);
      mobileMenuBtn?.setAttribute('aria-expanded', String(open));
      mobileMenuBtn?.setAttribute('aria-label', open ? '关闭菜单' : '打开菜单');
    }
    
    mobileMenuBtn?.addEventListener('click', () => {
      setMobileMenu(mobileMenu?.classList.contains('hidden'));
    });
    
    // 点击菜单外部关闭
    document.addEventListener('click', (e) => {
      if (!mobileMenuBtn?.contains(e.target) && !mobileMenu?.contains(e.target)) {
        setMobileMenu(false);
      }
    });
  </script>

  <!-- 主题切换脚本 -->
  <script>
    import { THEME_COLOR } from '../lib/brand';

    // 主题管理
    const themeToggleBtn = document.getElementById('theme-toggle-btn');

    // 点击轮播的顺序,与三种字形一一对应
    const THEME_ORDER = ['light', 'dark', 'system'];
    const themeLabel = (theme: string) => (theme === 'light' ? '亮色' : theme === 'dark' ? '暗色' : '跟随系统');

    // 获取当前主题:没有缓存就是跟随系统
    function getCurrentTheme() {
      return localStorage.getItem('theme') || 'system';
    }
    
    // 应用主题
    function applyTheme(theme) {
      const html = document.documentElement;
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      
      // 与 head 内联脚本保持一致:light 显式打标,system 交给媒体查询
      const isDark = theme === 'dark' || (theme === 'system' && prefersDark);
      html.classList.toggle('dark', isDark);
      html.classList.toggle('light', theme === 'light');
      document.querySelector('meta[name="theme-color"]')?.setAttribute('content', isDark ? THEME_COLOR.dark : THEME_COLOR.light);
      // 首屏图标已由 CSS 决定,这里只在偏好变更后同步属性
      html.dataset.theme = theme;
      
      // 保存主题偏好
      localStorage.setItem('theme', theme);
      
      // 按钮提示当前档位(字形已由 data-theme 交给 CSS)
      themeToggleBtn?.setAttribute('aria-label', `切换主题，当前${themeLabel(theme)}`);
      themeToggleBtn?.setAttribute('title', `切换主题（当前：${themeLabel(theme)}）`);
    }
    
    // 初始化主题
    function initTheme() {
      const savedTheme = getCurrentTheme();
      applyTheme(savedTheme);
    }

    themeToggleBtn?.addEventListener('click', () => {
      const next = THEME_ORDER[(THEME_ORDER.indexOf(getCurrentTheme()) + 1) % THEME_ORDER.length];
      applyTheme(next);
    });
    
    // 监听系统主题变化
    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
      if (getCurrentTheme() === 'system') {
        applyTheme('system');
      }
    });
    
    // 页面加载时初始化
    initTheme();
  </script>

  <!-- 液态玻璃的几何折射层。材质本身在 global.css 里,这段只补 CSS 做不到的背景弯折,
       且只在 Blink 内核装配;非 Blink 直接 return,退回纯 CSS 玻璃 -->
  <script>
    import { initLiquidGlass } from '../lib/liquid-glass';
    initLiquidGlass();
  </script>
</body>
</html>

<style>
  /* 主题字形三选一:data-theme 由 head 的 pre-paint 脚本写入,首屏就是正确字形 */
  :root .theme-glyph {
    display: none;
  }

  :root[data-theme='light'] .theme-glyph-light,
  :root[data-theme='dark'] .theme-glyph-dark,
  :root[data-theme='system'] .theme-glyph-system {
    display: inline-block;
  }
</style>
