---
// Docker 加速页面
import Layout from '../layouts/Layout.astro';
import LinePicker from '../components/LinePicker.astro';
---

<Layout
  title="Docker 加速"
  description="加速 Docker Hub、GHCR、GCR、Quay、MCR 镜像仓库的拉取，registry 认证与 token 交换由代理服务端完成。"
  activeNav="/docker"
>
  <!-- 页面标题 + 线路选择：选了哪条，下面示例里的前缀就换成哪条(src/lib/lines.ts) -->
  <div class="relative z-20 mb-6 flex flex-wrap items-end justify-between gap-x-4 gap-y-3">
    <div class="min-w-0">
      <h1 class="text-2xl sm:text-3xl font-medium text-on-surface mb-2">Docker 加速</h1>
      <p class="text-on-surface-variant">支持 Docker Hub、GHCR、GCR、Quay、MCR 等镜像仓库的加速拉取</p>
    </div>
    <div class="flex items-center justify-between gap-3 w-full sm:w-auto sm:justify-end">
      <span class="text-sm text-on-surface-variant">加速线路</span>
      <LinePicker />
    </div>
  </div>

  <!-- 配置说明 -->
  <div class="lg rounded-3xl p-4 sm:p-6 mb-6">
    <h2 class="text-xl font-medium text-on-surface mb-4 flex items-center gap-3">
      <span class="icon-[material-symbols--settings] text-primary"></span>
      配置 Docker 镜像加速
    </h2>

    <div class="bg-primary-container text-on-primary-container rounded-2xl px-5 py-4 mb-5 flex gap-3 text-sm">
      <span class="icon-[material-symbols--info] text-xl shrink-0"></span>
      <span>配置 Docker 镜像加速器后，拉取 Docker Hub、GHCR、GCR、Quay 等镜像将自动通过代理加速。</span>
    </div>

    <div class="bg-surface rounded-2xl overflow-hidden border border-outline-variant mb-4">
      <div class="flex items-center justify-between px-4 py-3 bg-surface-container border-b border-outline-variant">
        <span class="text-sm font-medium text-on-surface">配置 daemon.json</span>
        <button aria-label="复制代码" class="copy-btn w-9 h-9 rounded-full flex items-center justify-center text-on-surface-variant hover:bg-primary/10 hover:text-primary transition-colors">
          <span class="icon-[material-symbols--content-copy] text-lg"></span>
        </button>
      </div>
      <div class="p-4 font-mono text-sm leading-relaxed overflow-x-auto">
        <span class="text-on-surface-variant opacity-70"># /etc/docker/daemon.json</span><br>
        &#123;<br>
        &nbsp;&nbsp;<span class="text-tertiary">"registry-mirrors"</span>: [<span class="text-tertiary">"{Astro.url.origin}"</span>]<br>
        &#125;
      </div>
    </div>

    <div class="bg-surface rounded-2xl overflow-hidden border border-outline-variant">
      <div class="flex items-center justify-between px-4 py-3 bg-surface-container border-b border-outline-variant">
        <span class="text-sm font-medium text-on-surface">重启 Docker 服务</span>
        <button aria-label="复制代码" class="copy-btn w-9 h-9 rounded-full flex items-center justify-center text-on-surface-variant hover:bg-primary/10 hover:text-primary transition-colors">
          <span class="icon-[material-symbols--content-copy] text-lg"></span>
        </button>
      </div>
      <div class="p-4 font-mono text-sm leading-relaxed overflow-x-auto">
        <span class="text-on-surface-variant opacity-70"># 重启 Docker 服务</span><br>
        <span class="text-primary font-semibold">sudo</span> systemctl daemon-reload<br>
        <span class="text-primary font-semibold">sudo</span> systemctl restart docker<br><br>
        <span class="text-on-surface-variant opacity-70"># 或者直接拉取镜像（无需配置）</span><br>
        <span class="text-primary font-semibold">docker</span> pull <span class="text-tertiary">{Astro.url.origin}</span>/library/nginx:latest
      </div>
    </div>
  </div>

  <!-- 支持的 Registry -->
  <div class="lg rounded-3xl p-4 sm:p-6">
    <h2 class="text-xl font-medium text-on-surface mb-4">支持的 Registry</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
      <div class="bg-surface-container rounded-2xl px-4 py-3.5 flex flex-col gap-1.5 sm:flex-row sm:items-center sm:gap-3">
        <code class="font-mono text-sm font-semibold text-primary bg-primary-container px-2.5 py-1 rounded-lg min-w-[80px] self-start sm:self-auto text-center">/v2/</code>
        <span class="text-on-surface-variant text-sm">Docker Hub (registry-1.docker.io)</span>
      </div>
      <div class="bg-surface-container rounded-2xl px-4 py-3.5 flex flex-col gap-1.5 sm:flex-row sm:items-center sm:gap-3">
        <code class="font-mono text-sm font-semibold text-primary bg-primary-container px-2.5 py-1 rounded-lg min-w-[80px] self-start sm:self-auto text-center">/api/ghcr/</code>
        <span class="text-on-surface-variant text-sm">GitHub Container Registry</span>
      </div>
      <div class="bg-surface-container rounded-2xl px-4 py-3.5 flex flex-col gap-1.5 sm:flex-row sm:items-center sm:gap-3">
        <code class="font-mono text-sm font-semibold text-primary bg-primary-container px-2.5 py-1 rounded-lg min-w-[80px] self-start sm:self-auto text-center">/api/gcr/</code>
        <span class="text-on-surface-variant text-sm">Google Container Registry</span>
      </div>
      <div class="bg-surface-container rounded-2xl px-4 py-3.5 flex flex-col gap-1.5 sm:flex-row sm:items-center sm:gap-3">
        <code class="font-mono text-sm font-semibold text-primary bg-primary-container px-2.5 py-1 rounded-lg min-w-[80px] self-start sm:self-auto text-center">/api/k8s/</code>
        <span class="text-on-surface-variant text-sm">Kubernetes Registry</span>
      </div>
      <div class="bg-surface-container rounded-2xl px-4 py-3.5 flex flex-col gap-1.5 sm:flex-row sm:items-center sm:gap-3">
        <code class="font-mono text-sm font-semibold text-primary bg-primary-container px-2.5 py-1 rounded-lg min-w-[80px] self-start sm:self-auto text-center">/api/quay/</code>
        <span class="text-on-surface-variant text-sm">Red Hat Quay</span>
      </div>
      <div class="bg-surface-container rounded-2xl px-4 py-3.5 flex flex-col gap-1.5 sm:flex-row sm:items-center sm:gap-3">
        <code class="font-mono text-sm font-semibold text-primary bg-primary-container px-2.5 py-1 rounded-lg min-w-[80px] self-start sm:self-auto text-center">/api/mcr/</code>
        <span class="text-on-surface-variant text-sm">Microsoft Container Registry</span>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { initLines } from '../lib/lines';

  // 复制功能
  document.querySelectorAll('.copy-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const codeBlock = btn.closest('.bg-surface')?.querySelector('.font-mono');
      if (codeBlock) {
        navigator.clipboard.writeText(codeBlock.textContent || '');
        btn.innerHTML = '<span class="icon-[material-symbols--check] text-lg"></span>';
        setTimeout(() => {
          btn.innerHTML = '<span class="icon-[material-symbols--content-copy] text-lg"></span>';
        }, 2000);
      }
    });
  });

  initLines();
</script>
