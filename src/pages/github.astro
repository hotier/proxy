---
// GitHub 加速页面
import Layout from '../layouts/Layout.astro';
import LinePicker from '../components/LinePicker.astro';
---

<Layout
  title="GitHub 加速"
  description="加速 GitHub Release 下载、Git Clone、Raw 文件与源码归档，支持 release-assets、codeload、objects、api.github.com 等全部上游域名。"
  activeNav="/github"
>
  <!-- 页面标题 + 线路选择：选了哪条，下面所有示例里的前缀就换成哪条(src/lib/lines.ts) -->
  <div class="relative z-20 mb-6 flex flex-wrap items-end justify-between gap-x-4 gap-y-3">
    <div class="min-w-0">
      <h1 class="text-2xl sm:text-3xl font-medium text-on-surface mb-2">GitHub 加速</h1>
      <p class="text-on-surface-variant">支持 Release、Git Clone、Raw 文件、源码归档的加速下载</p>
    </div>
    <div class="flex items-center justify-between gap-3 w-full sm:w-auto sm:justify-end">
      <span class="text-sm text-on-surface-variant">加速线路</span>
      <LinePicker />
    </div>
  </div>

  <!-- 使用场景标签页 -->
  <div class="lg rounded-3xl p-4 sm:p-6 mb-6">
    <!-- 四个标签在手机上放不下(约 426px),允许换行后 w-fit 收到容器宽度即可,不再顶破卡片 -->
    <div class="flex flex-wrap gap-1 bg-surface-container-high rounded-2xl p-1 w-fit mb-6">
      <button class="tab-btn active px-4 sm:px-5 py-2 rounded-xl text-sm font-medium transition-colors" data-tab="release">
        Release 下载
      </button>
      <button class="tab-btn px-4 sm:px-5 py-2 rounded-xl text-sm font-medium transition-colors" data-tab="clone">
        Git Clone
      </button>
      <button class="tab-btn px-4 sm:px-5 py-2 rounded-xl text-sm font-medium transition-colors" data-tab="raw">
        Raw 文件
      </button>
      <button class="tab-btn px-4 sm:px-5 py-2 rounded-xl text-sm font-medium transition-colors" data-tab="archive">
        源码归档
      </button>
    </div>

    <!-- Release 下载 -->
    <div id="tab-release" class="tab-content">
      <div class="bg-surface rounded-2xl overflow-hidden border border-outline-variant">
        <div class="flex items-center justify-between px-4 py-3 bg-surface-container border-b border-outline-variant">
          <span class="text-sm font-medium text-on-surface">下载 Release 文件</span>
          <button aria-label="复制代码" class="copy-btn w-9 h-9 rounded-full flex items-center justify-center text-on-surface-variant hover:bg-primary/10 hover:text-primary transition-colors" data-code="release">
            <span class="icon-[material-symbols--content-copy] text-lg"></span>
          </button>
        </div>
        <div class="p-4 font-mono text-sm leading-relaxed overflow-x-auto">
          <span class="text-on-surface-variant opacity-70"># 原始链接</span><br>
          <span class="text-primary font-semibold">curl</span> -L -o gh.zip <span class="text-tertiary">https://github.com/cli/cli/releases/download/v2.67.0/gh_2.67.0_windows_amd64.zip</span><br><br>
          <span class="text-on-surface-variant opacity-70"># 加速链接</span><br>
          <span class="text-primary font-semibold">curl</span> -L -o gh.zip <span class="text-tertiary">{Astro.url.origin}/api/gh/cli/cli/releases/download/v2.67.0/gh_2.67.0_windows_amd64.zip</span>
        </div>
      </div>
    </div>

    <!-- Git Clone -->
    <div id="tab-clone" class="tab-content hidden">
      <div class="bg-surface rounded-2xl overflow-hidden border border-outline-variant">
        <div class="flex items-center justify-between px-4 py-3 bg-surface-container border-b border-outline-variant">
          <span class="text-sm font-medium text-on-surface">克隆 Git 仓库</span>
          <button aria-label="复制代码" class="copy-btn w-9 h-9 rounded-full flex items-center justify-center text-on-surface-variant hover:bg-primary/10 hover:text-primary transition-colors" data-code="clone">
            <span class="icon-[material-symbols--content-copy] text-lg"></span>
          </button>
        </div>
        <div class="p-4 font-mono text-sm leading-relaxed overflow-x-auto">
          <span class="text-on-surface-variant opacity-70"># 原始命令</span><br>
          <span class="text-primary font-semibold">git</span> clone https://github.com/cli/cli.git<br><br>
          <span class="text-on-surface-variant opacity-70"># 加速命令</span><br>
          <span class="text-primary font-semibold">git</span> clone <span class="text-tertiary">{Astro.url.origin}/api/gh/cli/cli.git</span><br><br>
          <span class="text-on-surface-variant opacity-70"># 或一键改写全局：此后所有 https://github.com/ 的 git 操作自动走加速</span><br>
          <span class="text-primary font-semibold">curl</span> -fsSL <span class="text-tertiary">{Astro.url.origin}/install/git.sh</span> | sh
        </div>
      </div>
    </div>

    <!-- Raw 文件 -->
    <div id="tab-raw" class="tab-content hidden">
      <div class="bg-surface rounded-2xl overflow-hidden border border-outline-variant">
        <div class="flex items-center justify-between px-4 py-3 bg-surface-container border-b border-outline-variant">
          <span class="text-sm font-medium text-on-surface">下载 Raw 文件</span>
          <button aria-label="复制代码" class="copy-btn w-9 h-9 rounded-full flex items-center justify-center text-on-surface-variant hover:bg-primary/10 hover:text-primary transition-colors" data-code="raw">
            <span class="icon-[material-symbols--content-copy] text-lg"></span>
          </button>
        </div>
        <div class="p-4 font-mono text-sm leading-relaxed overflow-x-auto">
          <span class="text-on-surface-variant opacity-70"># 原始链接</span><br>
          <span class="text-primary font-semibold">curl</span> <span class="text-tertiary">https://raw.githubusercontent.com/cli/cli/trunk/README.md</span><br><br>
          <span class="text-on-surface-variant opacity-70"># 加速链接</span><br>
          <span class="text-primary font-semibold">curl</span> <span class="text-tertiary">{Astro.url.origin}/api/ghraw/cli/cli/trunk/README.md</span>
        </div>
      </div>
    </div>

    <!-- 源码归档 -->
    <div id="tab-archive" class="tab-content hidden">
      <div class="bg-surface rounded-2xl overflow-hidden border border-outline-variant">
        <div class="flex items-center justify-between px-4 py-3 bg-surface-container border-b border-outline-variant">
          <span class="text-sm font-medium text-on-surface">下载源码归档</span>
          <button aria-label="复制代码" class="copy-btn w-9 h-9 rounded-full flex items-center justify-center text-on-surface-variant hover:bg-primary/10 hover:text-primary transition-colors" data-code="archive">
            <span class="icon-[material-symbols--content-copy] text-lg"></span>
          </button>
        </div>
        <div class="p-4 font-mono text-sm leading-relaxed overflow-x-auto">
          <span class="text-on-surface-variant opacity-70"># 下载 ZIP 归档</span><br>
          <span class="text-primary font-semibold">curl</span> -L -o cli.zip <span class="text-tertiary">{Astro.url.origin}/api/gh/cli/cli/archive/refs/heads/trunk.zip</span><br><br>
          <span class="text-on-surface-variant opacity-70"># 下载 TAR.GZ 归档</span><br>
          <span class="text-primary font-semibold">curl</span> -L -o cli.tar.gz <span class="text-tertiary">{Astro.url.origin}/api/gh/cli/cli/archive/refs/heads/trunk.tar.gz</span>
        </div>
      </div>
    </div>
  </div>

  <!-- 支持的端点 -->
  <div class="lg rounded-3xl p-4 sm:p-6">
    <h2 class="text-xl font-medium text-on-surface mb-4">支持的端点</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
      <div class="bg-surface-container rounded-2xl px-4 py-3.5 flex flex-col gap-1.5 sm:flex-row sm:items-center sm:gap-3">
        <code class="font-mono text-sm font-semibold text-primary bg-primary-container px-2.5 py-1 rounded-lg min-w-[100px] self-start sm:self-auto text-center">/api/gh/</code>
        <span class="text-on-surface-variant text-sm">github.com 全站代理</span>
      </div>
      <div class="bg-surface-container rounded-2xl px-4 py-3.5 flex flex-col gap-1.5 sm:flex-row sm:items-center sm:gap-3">
        <code class="font-mono text-sm font-semibold text-primary bg-primary-container px-2.5 py-1 rounded-lg min-w-[100px] self-start sm:self-auto text-center">/api/ghraw/</code>
        <span class="text-on-surface-variant text-sm">raw.githubusercontent.com</span>
      </div>
      <div class="bg-surface-container rounded-2xl px-4 py-3.5 flex flex-col gap-1.5 sm:flex-row sm:items-center sm:gap-3">
        <code class="font-mono text-sm font-semibold text-primary bg-primary-container px-2.5 py-1 rounded-lg min-w-[100px] self-start sm:self-auto text-center">/api/codeload/</code>
        <span class="text-on-surface-variant text-sm">codeload.github.com</span>
      </div>
      <div class="bg-surface-container rounded-2xl px-4 py-3.5 flex flex-col gap-1.5 sm:flex-row sm:items-center sm:gap-3">
        <code class="font-mono text-sm font-semibold text-primary bg-primary-container px-2.5 py-1 rounded-lg min-w-[100px] self-start sm:self-auto text-center">/api/objects/</code>
        <span class="text-on-surface-variant text-sm">objects.githubusercontent.com</span>
      </div>
      <div class="bg-surface-container rounded-2xl px-4 py-3.5 flex flex-col gap-1.5 sm:flex-row sm:items-center sm:gap-3">
        <code class="font-mono text-sm font-semibold text-primary bg-primary-container px-2.5 py-1 rounded-lg min-w-[100px] self-start sm:self-auto text-center">/api/release-assets/</code>
        <span class="text-on-surface-variant text-sm">release-assets.githubusercontent.com</span>
      </div>
      <div class="bg-surface-container rounded-2xl px-4 py-3.5 flex flex-col gap-1.5 sm:flex-row sm:items-center sm:gap-3">
        <code class="font-mono text-sm font-semibold text-primary bg-primary-container px-2.5 py-1 rounded-lg min-w-[100px] self-start sm:self-auto text-center">/api/api.github.com/</code>
        <span class="text-on-surface-variant text-sm">api.github.com API 代理</span>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { initLines } from '../lib/lines';

  // 标签页切换
  document.querySelectorAll('.tab-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const tabId = btn.dataset.tab;
      
      // 更新按钮状态
      document.querySelectorAll('.tab-btn').forEach(b => {
        b.classList.remove('bg-primary', 'text-on-primary');
        b.classList.add('text-on-surface-variant');
      });
      btn.classList.remove('text-on-surface-variant');
      btn.classList.add('bg-primary', 'text-on-primary');
      
      // 切换内容
      document.querySelectorAll('.tab-content').forEach(c => c.classList.add('hidden'));
      document.getElementById('tab-' + tabId)?.classList.remove('hidden');
    });
  });
  
  // 初始化第一个标签页
  document.querySelector('.tab-btn')?.classList.add('bg-primary', 'text-on-primary');
  
  // 复制功能
  document.querySelectorAll('.copy-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const codeBlock = btn.closest('.bg-surface')?.querySelector('.font-mono');
      if (codeBlock) {
        navigator.clipboard.writeText(codeBlock.textContent || '');
        btn.innerHTML = '<span class="icon-[material-symbols--check] text-lg"></span>';
        setTimeout(() => {
          btn.innerHTML = '<span class="icon-[material-symbols--content-copy] text-lg"></span>';
        }, 2000);
      }
    });
  });

  initLines();
</script>
