---
// 状态和配置页面
import Layout from '../layouts/Layout.astro';
import { ACCESS_DOMAINS } from '../lib/domains';

// 服务节点列表配置；图标类名必须是完整字面量（构建期图标引擎按源码扫描）
const services = [
  { key: 'github', icon: 'icon-[simple-icons--github]', name: 'GitHub 加速' },
  { key: 'docker', icon: 'icon-[simple-icons--docker]', name: 'Docker 加速' },
  { key: 'npm', icon: 'icon-[simple-icons--npm]', name: 'npm 加速' },
  { key: 'go', icon: 'icon-[simple-icons--go]', name: 'Go 模块加速' },
  { key: 'jsd', icon: 'icon-[simple-icons--jsdelivr]', name: 'jsDelivr 加速' },
  { key: 'unpkg', icon: 'icon-[simple-icons--unpkg]', name: 'unpkg 加速' },
  { key: 'maven', icon: 'icon-[simple-icons--apachemaven]', name: 'Maven 加速' },
  { key: 'mcr', icon: 'icon-[simple-icons--microsoft]', name: 'MCR 镜像加速' },
  { key: 'pypi', icon: 'icon-[simple-icons--pypi]', name: 'PyPI 加速' },
];
---

<Layout
  title="服务状态"
  description="迅源 SwiftOrigin 各加速节点的连通性探测与使用次数、流量、访客统计，按服务维度实时汇总。"
  activeNav="/status"
>
  <!-- 页面标题：服务节点列表的刷新按钮放在页头右侧，不进表格 -->
  <div class="flex items-start justify-between gap-3 mb-6">
    <div>
      <h1 class="text-2xl sm:text-3xl font-medium text-on-surface mb-2">服务状态</h1>
      <p class="text-on-surface-variant">实时监控各节点状态和请求配额使用情况</p>
    </div>
    <div class="flex shrink-0 items-center gap-2 pt-2">
      <span id="refreshed-at-services" class="text-xs text-on-surface-variant"></span>
      <button id="refresh-btn-services" type="button" aria-label="刷新服务状态" title="刷新" class="w-9 h-9 rounded-full flex items-center justify-center text-on-surface-variant hover:bg-primary/10 hover:text-primary transition-colors disabled:opacity-50 disabled:pointer-events-none">
        <span id="refresh-icon-services" class="icon-[material-symbols--refresh] text-lg"></span>
      </button>
    </div>
  </div>

  <!-- 服务节点列表：每服务一行，状态与请求/流量统计均为文本 -->
  <div class="lg rounded-3xl p-4 sm:p-6 mb-6" id="status-cards">
    <div class="overflow-x-auto">
      <!-- table-fixed + 百分比列宽：列宽与单元格内容解耦，数字自增动画只换字形不会推挤列宽 -->
      <!-- 窄屏(<md)由 scoped CSS 展开成两列卡片：7 列 + min-w-[780px] 在手机上逃不掉横向滚动 -->
      <table class="status-table w-full table-fixed text-sm min-w-[780px]">
        <thead>
          <tr class="text-left text-on-surface-variant border-b border-surface-variant">
            <th class="py-3 pr-3 font-medium w-[20%]">服务</th>
            <th class="py-3 px-3 font-medium w-[13%]">状态</th>
            <th class="py-3 px-3 font-medium text-right w-[11%]">延迟</th>
            <th class="py-3 px-3 font-medium text-right w-[15%]">今日请求</th>
            <th class="py-3 px-3 font-medium text-right w-[13%]">今日流量</th>
            <th class="py-3 px-3 font-medium text-right w-[15%]">累计请求</th>
            <th class="py-3 pl-3 font-medium text-right w-[13%]">累计流量</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-surface-variant">
          {services.map((svc) => (
            <tr>
              <td class="py-3.5 pr-3">
                <div class="flex items-center gap-3">
                  <span class:list={[svc.icon, 'text-xl text-on-surface']}></span>
                  <div class="font-medium text-on-surface">{svc.name}</div>
                </div>
              </td>
              <td class="py-3.5 px-3 whitespace-nowrap" data-label="状态">
                <span id={`${svc.key}-status-dot`} class="inline-block w-3 h-3 rounded-full bg-gray-400 animate-pulse"></span>
                <span id={`${svc.key}-status-text`} class="ml-2 text-on-surface-variant">检测中...</span>
              </td>
              <td class="py-3.5 px-3 text-right font-mono text-on-surface-variant" id={`${svc.key}-response-time`} data-label="延迟">-</td>
              <td class="py-3.5 px-3 text-right font-mono text-on-surface" id={`${svc.key}-today-uses`} data-label="今日请求">-</td>
              <td class="py-3.5 px-3 text-right font-mono text-primary" id={`${svc.key}-today-bytes`} data-label="今日流量">-</td>
              <td class="py-3.5 px-3 text-right font-mono text-on-surface" id={`${svc.key}-total-uses`} data-label="累计请求">-</td>
              <td class="py-3.5 pl-3 text-right font-mono text-primary" id={`${svc.key}-total-bytes`} data-label="累计流量">-</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <!-- 访问统计：刷新只作用于本卡片（主站访问 + 平台用量） -->
  <div class="lg rounded-3xl p-4 sm:p-6 mb-6">
    <div class="flex items-center justify-between gap-3 mb-4">
      <h2 class="text-xl font-medium text-on-surface flex items-center gap-3">
        <span class="icon-[material-symbols--analytics] text-primary"></span>
        访问统计
      </h2>
      <div class="flex items-center gap-2">
        <span id="refreshed-at-stats" class="text-xs text-on-surface-variant"></span>
        <button id="refresh-btn-stats" type="button" aria-label="刷新访问统计" title="刷新" class="w-9 h-9 rounded-full flex items-center justify-center text-on-surface-variant hover:bg-primary/10 hover:text-primary transition-colors disabled:opacity-50 disabled:pointer-events-none">
          <span id="refresh-icon-stats" class="icon-[material-symbols--refresh] text-lg"></span>
        </button>
      </div>
    </div>
    
    <!-- 主站访问统计 -->
    <div class="mb-6">
      <h3 class="text-sm font-medium text-on-surface-variant mb-3">主站访问</h3>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <div class="bg-surface rounded-2xl p-4">
          <div class="text-xs text-on-surface-variant mb-1">今日浏览</div>
          <div class="text-xl font-medium text-on-surface" id="today-page-views">-</div>
        </div>
        <div class="bg-surface rounded-2xl p-4">
          <div class="text-xs text-on-surface-variant mb-1">今日访客</div>
          <div class="text-xl font-medium text-primary" id="today-visitors">-</div>
        </div>
        <div class="bg-surface rounded-2xl p-4">
          <div class="text-xs text-on-surface-variant mb-1">累计浏览</div>
          <div class="text-xl font-medium text-on-surface" id="total-page-views">-</div>
        </div>
        <div class="bg-surface rounded-2xl p-4">
          <div class="text-xs text-on-surface-variant mb-1">累计访客</div>
          <div class="text-xl font-medium text-primary" id="total-visitors">-</div>
        </div>
      </div>
    </div>

    <!-- Deno Deploy 平台用量 -->
    <div>
      <h3 class="text-sm font-medium text-on-surface-variant mb-3">平台用量</h3>
      <div id="deno-analytics-note" class="hidden -mt-2 mb-3 text-xs text-on-surface-variant"></div>
      <!-- 今日来自平台分析接口的本次窗口；累计来自本站按 UTC 日归档到 KV 的平台用量 -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <div class="bg-surface rounded-2xl p-4">
          <div class="text-xs text-on-surface-variant mb-1">今日请求数</div>
          <div class="text-xl font-medium text-on-surface" id="deno-requests">-</div>
        </div>
        <div class="bg-surface rounded-2xl p-4">
          <div class="text-xs text-on-surface-variant mb-1">今日 CPU 时间</div>
          <div class="text-xl font-medium text-primary" id="deno-cpu">-</div>
        </div>
        <div class="bg-surface rounded-2xl p-4">
          <div class="text-xs text-on-surface-variant mb-1">今日入站流量</div>
          <div class="text-xl font-medium text-on-surface" id="deno-ingress">-</div>
        </div>
        <div class="bg-surface rounded-2xl p-4">
          <div class="text-xs text-on-surface-variant mb-1">今日出站流量</div>
          <div class="text-xl font-medium text-primary" id="deno-egress">-</div>
        </div>
        <div class="bg-surface rounded-2xl p-4">
          <div class="text-xs text-on-surface-variant mb-1">累计请求数</div>
          <div class="text-xl font-medium text-on-surface" id="deno-total-requests">-</div>
        </div>
        <div class="bg-surface rounded-2xl p-4">
          <div class="text-xs text-on-surface-variant mb-1">累计 CPU 时间</div>
          <div class="text-xl font-medium text-primary" id="deno-total-cpu">-</div>
        </div>
        <div class="bg-surface rounded-2xl p-4">
          <div class="text-xs text-on-surface-variant mb-1">累计入站流量</div>
          <div class="text-xl font-medium text-on-surface" id="deno-total-ingress">-</div>
        </div>
        <div class="bg-surface rounded-2xl p-4">
          <div class="text-xs text-on-surface-variant mb-1">累计出站流量</div>
          <div class="text-xl font-medium text-primary" id="deno-total-egress">-</div>
        </div>
      </div>
      <div id="deno-total-note" class="mt-3 text-xs text-on-surface-variant"></div>
    </div>
  </div>

  <!-- 访问线路：对外只说线路几 + 域名，域名归属这类内部信息不展示。
       清单是部署期确定的静态数据(src/lib/domains)，不进轮询；延迟是访客各自打的探测，
       只在进页面时测一轮，右上角那个按钮可以手动重测 -->
  <div class="lg rounded-3xl p-4 sm:p-6 mb-6">
    <div class="flex items-center justify-between gap-3 mb-4">
      <div class="flex items-center gap-3">
        <span class="icon-[material-symbols--public] text-primary text-xl"></span>
        <h2 class="text-xl font-medium text-on-surface">加速线路</h2>
      </div>
      <div class="flex shrink-0 items-center gap-2">
        <span id="refreshed-at-lines" class="text-xs text-on-surface-variant"></span>
        <button id="refresh-btn-lines" type="button" aria-label="重新测速" title="重新测速" class="w-9 h-9 rounded-full flex items-center justify-center text-on-surface-variant hover:bg-primary/10 hover:text-primary transition-colors disabled:opacity-50 disabled:pointer-events-none">
          <span id="refresh-icon-lines" class="icon-[material-symbols--refresh] text-lg"></span>
        </button>
      </div>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {ACCESS_DOMAINS.map((d) => (
        <div class="bg-surface rounded-2xl p-4">
          <div class="flex items-center justify-between gap-3 mb-2">
            <span class="text-sm font-medium text-on-surface">{d.name}</span>
            <!-- 浏览器实测的探测延迟，由 src/lib/lines.ts 填；这里不展示选中态，状态页只报可达性与快慢 -->
            <span class="text-xs tabular-nums text-on-surface-variant shrink-0" data-line-latency={d.host}></span>
          </div>
          <a
            href={`https://${d.host}`}
            target="_blank"
            rel="noopener"
            class="font-mono text-sm text-primary hover:underline break-all"
          >{d.host}</a>
        </div>
      ))}
    </div>
  </div>
</Layout>

<script>
  import { LATENCY_EVENT, initLines, latencyUpdatedAt, refreshLatency } from '../lib/lines';

  // 状态页要展示的服务节点，与探测结果里的键一致
  const NODES = ['github', 'docker', 'npm', 'go', 'jsd', 'unpkg', 'maven', 'mcr', 'pypi'];

  // 一轮刷新只发一个请求：/api/dashboard 同时返回上游探测、本站统计与平台用量三段。
  // 原本一轮要发三个请求，每个都要过一次中间件与路由，而免费额度按 CPU 时间计费。
  // 本地有效期只用于页面加载（该 scope 的段都还新鲜就不发请求）；到期轮询总是重取，
  // 但回不回源由服务端各段的缓存决定（探测 PROBE_TTL_MS、用量 ANALYTICS_TTL_MS），
  // 同一实例上的多个访客因此共享一次探测与用量计算
  const SECTION_TTL = { services: 120000, stats: 120000, analytics: 300000 };
  // 兼作到期轮询间隔；服务端探测 TTL 比它大，轮询才不会每轮都回源
  const POLL_MS = SECTION_TTL.services;
  const CACHE_KEY = 'status-cache:dashboard';

  // 两张卡片各自一套刷新控件：按钮的忙态与"数据更新于"只影响本卡片
  // services = 服务节点列表（状态/延迟 + 表内各服务请求流量）
  // stats    = 访问统计（主站浏览访客 + Deno 平台用量）
  const SCOPES = {
    services: { busy: 0, btn: 'refresh-btn-services', icon: 'refresh-icon-services', at: 'refreshed-at-services' },
    stats: { busy: 0, btn: 'refresh-btn-stats', icon: 'refresh-icon-stats', at: 'refreshed-at-stats' },
  };
  type Scope = keyof typeof SCOPES | 'all';

  // 每个 scope 用到哪几段：手动刷新只重取本卡片需要的段，不为另一张卡片付费。
  // 统计段两张卡片共用（表内请求流量与访问统计同源），所以三处都含它
  const SECTIONS: Record<Scope, ('services' | 'stats' | 'analytics')[]> = {
    services: ['services', 'stats'],
    stats: ['stats', 'analytics'],
    all: ['services', 'stats', 'analytics'],
  };

  // 三段共用一个本地键，各段记自己的写入时间
  function readLocal() {
    try {
      return JSON.parse(localStorage.getItem(CACHE_KEY) || '{}');
    } catch {
      return {};
    }
  }

  function writeLocal(sections: Record<string, { ts: number; data: any }>) {
    const store = { ...readLocal(), ...sections };
    try {
      localStorage.setItem(CACHE_KEY, JSON.stringify(store));
    } catch {
      // 隐私模式或配额满时退化为无缓存
    }
    return store;
  }

  function takeSections(store: Record<string, { ts: number; data: any }>, names: string[]) {
    const out: Record<string, { ts: number; data: any }> = {};
    for (const name of names) if (store[name]) out[name] = store[name];
    return out;
  }

  function atText(ts: number) {
    return '数据更新于 ' + new Date(ts).toLocaleTimeString('zh-CN');
  }

  function showRefreshedAt(scope: Scope, ts: number) {
    const text = atText(ts);
    cardsOf(scope).forEach((card) => updateElement(card.at, text));
  }

  function applySections(sections: Record<string, { ts: number; data: any }>, scope: Scope) {
    if (sections.services) applyNodes(sections.services.data);
    if (sections.stats) applyStats(sections.stats.data, scope);
    if (sections.analytics) applyDenoAnalytics(sections.analytics.data);
    // 「数据更新于」取本次渲染里最新的那一段
    const ts = Math.max(
      sections.stats?.ts ?? 0,
      sections.analytics?.ts ?? 0,
      sections.services?.ts ?? 0
    );
    showRefreshedAt(scope, ts || Date.now());
  }

  // 检查节点状态：在线 / 异常(上游返回错误码) / 离线(探测失败或上游无响应)
  // force 跳过本地缓存；fresh 额外跳过服务端缓存（只有手动刷新按钮值得付这个出网代价）
  async function loadDashboard(scope: Scope, force: boolean, fresh: boolean) {
    const names = SECTIONS[scope];
    if (!force) {
      const cached = readLocal();
      if (names.every((name) => cached[name] && Date.now() - cached[name].ts < SECTION_TTL[name])) {
        applySections(takeSections(cached, names), scope);
        return;
      }
    }
    beginBusy(scope);
    try {
      const response = await fetch('/api/dashboard?scope=' + scope + (fresh ? '&force=1' : ''));
      const data = await response.json();
      const sections: Record<string, { ts: number; data: any }> = {};
      for (const name of names) {
        // 服务端按 scope 省略不属于本卡片的段，缺段不覆盖已有缓存
        if (data[name] !== undefined) sections[name] = { ts: data.generatedAt || Date.now(), data: data[name] };
      }
      // 只渲染本次真的取到的段，其余段留给下一次带自己 scope 的刷新
      writeLocal(sections);
      applySections(sections, scope);
    } catch (error) {
      console.error('Failed to fetch dashboard:', error);
      if (scope !== 'stats') NODES.forEach((type) => updateStatusUI(type, 'offline', null));
      if (scope !== 'services') applyDenoAnalytics({ success: false, error: '请求失败' });
    } finally {
      endBusy(scope);
    }
  }

  function applyNodes(services: any) {
    NODES.forEach((type) => {
      const result = services?.[type];
      if (!result) {
        updateStatusUI(type, 'offline', null);
        return;
      }
      const state = result.status === 'ok' ? 'online' : result.statusCode ? 'error' : 'offline';
      updateStatusUI(type, state, state === 'offline' ? null : result.responseTime || 0);
    });
  }

  // 更新状态 UI（延迟为独立列，类名字符串需保留表格单元格的布局位）
  const STATE_STYLES = {
    online:  { dot: 'inline-block w-3 h-3 rounded-full align-middle bg-green-500', text: 'ml-2 text-sm text-green-600', label: '在线' },
    error:   { dot: 'inline-block w-3 h-3 rounded-full align-middle bg-amber-500', text: 'ml-2 text-sm text-amber-600', label: '异常' },
    offline: { dot: 'inline-block w-3 h-3 rounded-full align-middle bg-red-500', text: 'ml-2 text-sm text-red-600', label: '离线' },
  };

  function updateStatusUI(type, state, duration) {
    const dot = document.getElementById(type + '-status-dot');
    const text = document.getElementById(type + '-status-text');
    const timeEl = document.getElementById(type + '-response-time');
    const style = STATE_STYLES[state];
    
    if (dot) dot.className = style.dot;
    
    if (text) {
      text.textContent = style.label;
      text.className = style.text;
    }
    
    if (timeEl) {
      // 完整类名字面量,保证 Tailwind 能扫描到
      if (duration === null) {
        timeEl.textContent = '—';
        timeEl.className = 'py-3.5 px-3 text-right font-mono text-on-surface-variant';
      } else {
        timeEl.textContent = duration + 'ms';
        const color = duration < 200 ? 'text-green-600' : duration < 500 ? 'text-yellow-600' : 'text-red-600';
        timeEl.className = 'py-3.5 px-3 text-right font-mono ' + color;
      }
    }
  }

  // 辅助函数：更新元素文本
  function updateElement(id, text) {
    const el = document.getElementById(id);
    if (el) el.textContent = text;
  }

  // 数值格式化
  function formatNumber(n) {
    return (n || 0).toLocaleString('zh-CN');
  }
  function formatBytes(b) {
    if (!b) return '0 B';
    const k = 1024;
    const sizes = ['B', 'KB', 'MB', 'GB', 'TB', 'PB'];
    // 递增动画中途会出现不足 1 字节的小数，取下界否则 sizes 会索引到 undefined
    const i = Math.max(0, Math.min(sizes.length - 1, Math.floor(Math.log(b) / Math.log(k))));
    return parseFloat((b / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
  }

  const fmtInt = (n: number) => formatNumber(Math.round(n));
  // CPU 时间：不足一分钟保留秒的小数，累计值会长成难读的大秒数，改用 h/m/s 展开
  function fmtDuration(n: number) {
    const s = n || 0;
    if (s < 60) return Math.round(s * 100) / 100 + 's';
    const h = Math.floor(s / 3600);
    const m = Math.floor((s % 3600) / 60);
    return h ? h + 'h ' + m + 'm' : m + 'm ' + Math.round(s % 60) + 's';
  }

  // 数字增长入场：首次渲染从 0 递增到终值，所有数字共用一个 rAF 循环
  const TWEEN_MS = 850;
  const REDUCED_MOTION = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  // 入场只放一次：到期轮询与手动刷新直接写终值，避免读数每次跳动
  const entered = { stats: false, deno: false };
  const tweens: { el: HTMLElement; target: number; fmt: (n: number) => string; start: number }[] = [];
  let tweenRunning = false;

  function enterOnce(key: 'stats' | 'deno') {
    if (entered[key]) return false;
    entered[key] = true;
    return true;
  }

  function pumpTweens(now: number) {
    tweenRunning = false;
    for (let i = tweens.length - 1; i >= 0; i--) {
      const tw = tweens[i];
      const p = Math.min(1, (now - tw.start) / TWEEN_MS);
      // easeOutCubic：起步快、收尾不跳，最后一定落在格式化后的终值
      tw.el.textContent = tw.fmt(tw.target * (1 - Math.pow(1 - p, 3)));
      if (p >= 1) tweens.splice(i, 1);
    }
    if (tweens.length) {
      tweenRunning = true;
      requestAnimationFrame(pumpTweens);
    }
  }

  function setMetric(id: string, value: number, fmt: (n: number) => string, animate: boolean) {
    const el = document.getElementById(id);
    if (!el) return;
    // 减少动效偏好，以及后台标签页（rAF 不执行）都直接写终值，切回页面时不会停在 0
    if (!animate || REDUCED_MOTION || document.hidden) {
      el.textContent = fmt(value || 0);
      return;
    }
    const stale = tweens.findIndex((tw) => tw.el === el);
    if (stale >= 0) tweens.splice(stale, 1);
    el.textContent = fmt(0);
    tweens.push({ el, target: value || 0, fmt, start: performance.now() });
    if (!tweenRunning) {
      tweenRunning = true;
      requestAnimationFrame(pumpTweens);
    }
  }

  // 同一份 /api/stats 里含两张卡片的数据，按 scope 只渲染各自卡片内的部分
  function applyStats(data: any, scope: Scope) {
    const animate = enterOnce('stats');
    const today = data.today || {};
    const total = data.total || {};

    if (scope !== 'services') {
      // 主站访问
      setMetric('today-page-views', today.pageViews, fmtInt, animate);
      setMetric('today-visitors', today.visitors, fmtInt, animate);
      setMetric('total-page-views', total.pageViews, fmtInt, animate);
      setMetric('total-visitors', total.visitors, fmtInt, animate);
    }

    if (scope !== 'stats') {
      // 各加速节点统计(表格内今日/累计请求与流量)；列名写「请求」，值仍是收敛后的使用次数，口径见 services.isUsageRequest
      for (const svc of NODES) {
        const t = today[svc] || {};
        const c = total[svc] || {};
        setMetric(svc + '-today-uses', t.uses, fmtInt, animate);
        setMetric(svc + '-today-bytes', t.bytes, formatBytes, animate);
        setMetric(svc + '-total-uses', c.uses, fmtInt, animate);
        setMetric(svc + '-total-bytes', c.bytes, formatBytes, animate);
      }
    }
  }

  // 获取 Deno Deploy Analytics
  // 今日流量优先用原始字节数本地格式化，才能跟着一起递增；旧缓存没有该字段时退回服务端字符串
  function applyDenoAnalytics(data) {
    const note = document.getElementById('deno-analytics-note');

    if (data.success) {
      const animate = enterOnce('deno');
      const total = data.total || {};
      note?.classList.add('hidden');
      setMetric('deno-requests', data.today.requests, fmtInt, animate);
      setMetric('deno-cpu', data.today.cpuTime, fmtDuration, animate);
      if (typeof data.today.ingressBytes === 'number') {
        setMetric('deno-ingress', data.today.ingressBytes, formatBytes, animate);
      } else {
        updateElement('deno-ingress', data.today.ingressFormatted);
      }
      if (typeof data.today.egressBytes === 'number') {
        setMetric('deno-egress', data.today.egressBytes, formatBytes, animate);
      } else {
        updateElement('deno-egress', data.today.egressFormatted);
      }
      // 累计读本站 KV 的按日存档：平台只保证返回窗口内的桶，更早的历史由本站留存
      setMetric('deno-total-requests', total.requests, fmtInt, animate);
      setMetric('deno-total-cpu', total.cpuTime, fmtDuration, animate);
      setMetric('deno-total-ingress', total.ingressBytes, formatBytes, animate);
      setMetric('deno-total-egress', total.egressBytes, formatBytes, animate);
      // 正常情况不必在页面上交代归档口径，只有后端不可用才需要如实提示
      updateElement(
        'deno-total-note',
        total.degraded ? '日归档后端不可用，当前累计只覆盖本次查询窗口' : ''
      );
    } else {
      if (note) {
        note.textContent = data.error === 'DEPLOY_ANALYTICS_TOKEN is not configured'
          ? '未配置 DEPLOY_ANALYTICS_TOKEN 环境变量，平台用量数据不可用'
          : '平台用量数据获取失败：' + (data.error || '未知错误');
        note.classList.remove('hidden');
      }
    }
  }

  // 刷新按钮忙态：本卡片任一请求在途即禁用并让图标旋转，全部落地后恢复
  // scope 为 all 表示这一次取数同时喂两张卡片（页面加载与到期轮询）
  function cardsOf(scope: Scope) {
    return scope === 'all' ? Object.values(SCOPES) : [SCOPES[scope]];
  }

  function beginBusy(scope: Scope) {
    cardsOf(scope).forEach((card) => {
      card.busy++;
      const btn = document.getElementById(card.btn) as HTMLButtonElement | null;
      if (btn) btn.disabled = true;
      document.getElementById(card.icon)?.classList.add('animate-spin');
    });
  }

  function endBusy(scope: Scope) {
    cardsOf(scope).forEach((card) => {
      card.busy--;
      if (card.busy > 0) return;
      card.busy = 0;
      const btn = document.getElementById(card.btn) as HTMLButtonElement | null;
      if (btn) btn.disabled = false;
      document.getElementById(card.icon)?.classList.remove('animate-spin');
    });
  }

  // 初始加载：本地缓存未过期则直接渲染，不发请求
  loadDashboard('all', false, false);
  // 手动刷新：只重取各自卡片内的段，本地与服务端缓存一起绕过，确保拿到真实的新读数
  document.getElementById('refresh-btn-services')?.addEventListener('click', () => loadDashboard('services', true, true));
  document.getElementById('refresh-btn-stats')?.addEventListener('click', () => loadDashboard('stats', true, true));

  // 线路延迟只在进页面时测一轮（10 分钟内跨页复用缓存），页面开着不会自己重测，所以给个手动入口。
  // 不做成定时轮询：探测是每个访客各自发的，为一张状态页反复打请求等于白花边缘 CPU
  const linesBtn = document.getElementById('refresh-btn-lines') as HTMLButtonElement | null;
  linesBtn?.addEventListener('click', () => {
    linesBtn.disabled = true;
    document.getElementById('refresh-icon-lines')?.classList.add('animate-spin');
    void refreshLatency().then(() => {
      linesBtn.disabled = false;
      document.getElementById('refresh-icon-lines')?.classList.remove('animate-spin');
    });
  });

  // 延迟不是服务端返回的数据，没有响应时间戳可显示；这里报页面上这几条线路最近一次探测的时间，
  // 也就是缓存的写入时刻——跨页复用缓存时它可能比本次打开页面更早，那正是这几个读数的真实年龄
  window.addEventListener(LATENCY_EVENT, () => {
    const at = latencyUpdatedAt();
    if (at) updateElement('refreshed-at-lines', atText(at));
  });

  // 到期自动刷新：只绕过本地缓存（否则同频的 TTL 会让数据永不更新），
  // 仍走服务端缓存，让同一实例上的多个访客共享一次出网探测
  // 没人看就不必付费：后台标签页不轮询；前台超过 IDLE_MS 没有任何交互，
  // 说明是忘关的标签页，同样停掉——免费额度按 CPU 时间计费
  const IDLE_MS = 5 * 60 * 1000;
  let lastActiveAt = Date.now();
  let idle = false;

  // 只认明确的交互信号：鼠标停在页面上不该让轮询一直活着
  function wake(resync: boolean) {
    lastActiveAt = Date.now();
    if (idle) {
      idle = false;
      loadDashboard('all', true, false);
    } else if (resync) {
      loadDashboard('all', false, false);
    }
  }

  ['pointerdown', 'keydown', 'wheel'].forEach((event) =>
    document.addEventListener(event, () => wake(false), { passive: true })
  );

  setInterval(() => {
    if (document.visibilityState === 'hidden') return;
    if (Date.now() - lastActiveAt > IDLE_MS) {
      idle = true;
      return;
    }
    loadDashboard('all', true, false);
  }, POLL_MS);
  // 切回前台本身就是在看：立刻补一轮，不等下一个 tick
  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState !== 'hidden') wake(true);
  });

  // 线路卡片上的延迟徽标：状态页没有选择器，只需要测速这一部分
  initLines();
</script>
